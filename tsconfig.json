{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": ["examples/ts/**/*.ts", "tests/**/*.ts", "vitest.config.mts"]
}
