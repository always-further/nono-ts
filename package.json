{
  "name": "nono-ts",
  "version": "0.4.1",
  "description": "Node.js/TypeScript bindings for nono capability-based sandboxing",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "author": "Luke Hinds",
  "keywords": [
    "sandbox",
    "security",
    "capability",
    "landlock",
    "seatbelt",
    "napi-rs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/always-further/nono.git"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "smoke:list": "node tests/smoke/list.js",
    "demo": "NONO_APPLY=1 node demo/sandboxed-file-transformer/index.js --offline",
    "demo:dry-run": "node demo/sandboxed-file-transformer/index.js --dry-run --offline",
    "demo:attack-test": "NONO_APPLY=1 node demo/sandboxed-file-transformer/index.js --offline --attack-test",
    "prepublishOnly": "npm run prepare:npm-publish -- --check-artifacts",
    "prepare:npm-publish": "node scripts/prepare-npm-publish.mjs",
    "prepare:npm-publish:dry-run": "node scripts/prepare-npm-publish.mjs --dry-run",
    "release:npm": "node scripts/release-npm.mjs",
    "release:npm:publish": "node scripts/release-npm.mjs --publish",
    "version:prepare": "bash scripts/prepare-version.sh",
    "lint": "biome check tests/ demo/",
    "format": "biome check --write tests/ demo/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@napi-rs/cli": "^3.0.0-alpha.63",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">= 22"
  },
  "napi": {
    "binaryName": "nono",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "dependencies": {
    "mintlify": "^4.2.345"
  }
}
